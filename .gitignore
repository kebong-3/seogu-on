# ── 비밀값: 실제 키가 든 파일은 절대 올리지 않습니다 ──
.env
.env.*
!.env.example

# ── 자동으로 만들어지는 것 ──
node_modules/
dist/
.vercel/
evidence/
__pycache__/
*.pyc

# vendor/ 의 압축본에서 dev/build 때 풀리는 3D 엔진 (압축본 vendor/*.tar.gz 는 올려야 합니다)
public/vendor/cesium/
public/vendor/cesium-building-*/

# 화면 시험이 실행할 때마다 다시 만드는 캡처·결과
