# Copy to .env.local ONLY for local development. Never commit real values.
# VWorld SDK key is browser-visible by design: enforce provider domain restrictions.
VWORLD_BROWSER_KEY=
VWORLD_DOMAIN=https://seogu-on.vercel.app
VWORLD_API_KEY=
DATA_GO_KR_SERVICE_KEY=
KMA_SERVICE_KEY=
SAFETYDATA_SERVICE_KEY=
EMERGENCY_SERVICE_KEY=
ITS_API_KEY=
ITS_CCTV_TYPE=its
SAFEMAP_SERVICE_KEY=
FLOODMAP_SERVICE_KEY=
TAAS_SERVICE_KEY=
TAAS_YEAR=2024
TAAS_SIDO=29
TAAS_GUGUN=140
AIRKOREA_SERVICE_KEY=
AIRKOREA_REGION_QUERY=광주
# Enable only after checking the ITS WMS service and usage conditions.
ITS_FLOW_ENABLED=false
# Classic v0.2 optional custom-source config:
DATA_SOURCES_JSON=

# Optional approved PUBLIC JSON APIs; keep credentials in the keyEnv variable, not in this JSON.
INFRA_SOURCES_JSON=[]

# v0.6: Consolidated provider-specific SafetyData credentials, SERVER ONLY.
# Generate ONE JSON value with tools/safety-key-import.html, then set it in Vercel.
# Do not put actual keys here, in public/, src/, screenshots or a repository commit.
SAFETYDATA_KEYS_JSON={}
# Optional exact, verified station/institution ID-to-coordinate mapping. Never use guessed centers.
SAFETYDATA_LOCATION_INDEX_JSON={}
# Optional individual overrides: SAFETYDATA_10804_KEY, SAFETYDATA_10942_KEY,
# SAFETYDATA_00117_KEY, SAFETYDATA_00058_KEY, SAFETYDATA_00026_KEY,
# SAFETYDATA_00242_KEY, SAFETYDATA_10926_KEY, SAFETYDATA_00195_KEY, SAFETYDATA_10005_KEY
