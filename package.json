{
  "name": "seo-on-digital-twin",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "펀온워크 · 서구 공간행정 웹 시제품",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "preview": "node scripts/dev.mjs --dist",
    "test:browser": "python3 tests/browser-v02.py",
    "test:components": "python3 tests/component-browser.py",
    "test:city": "node --test tests/city-*.test.mjs",
    "test:city-ui": "python3 tests/city-v04-ui.py",
    "test:city-ui:v03": "python3 tests/city-ui.py",
    "test:deployment": "node scripts/verify-release.mjs",
    "test:final-ui": "python3 tests/city-final-ui.py",
    "verify": "npm run check && npm test && npm run build && node scripts/audit-release.mjs",
    "collect:vworld": "node --env-file-if-exists=.env.local scripts/collect-vworld.mjs",
    "test:v05-ui": "python3 tests/v05-ui.py"
  },
  "license": "MIT"
}
