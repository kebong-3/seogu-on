{
  "name": "seo-on-digital-twin",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "펀온워크 · 서구 공간행정 웹 시제품",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
